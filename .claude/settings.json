{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "enabledPlugins": {
    "core@working-bee": true,
    "memory@working-bee": true,
    "python-backend@working-bee": true,
    "privacy@working-bee": true
  },
  "permissions": {
